# Managed MySQL profile for production-like deployments.
GAMEOPS_MYSQL_MANAGED=true
GAMEOPS_MYSQL_HOST=prod-mysql.example.rds.amazonaws.com
GAMEOPS_MYSQL_PORT=3306
GAMEOPS_MYSQL_DATABASE=gameops
GAMEOPS_MYSQL_USER=gameops_app
GAMEOPS_MYSQL_PASSWORD=change-me

# Application-side pool and slow operation telemetry exported at /metrics.
GAMEOPS_MYSQL_POOL_SIZE=10
GAMEOPS_MYSQL_CONNECT_TIMEOUT=5
GAMEOPS_MYSQL_READ_TIMEOUT=15
GAMEOPS_MYSQL_WRITE_TIMEOUT=15
GAMEOPS_MYSQL_SLOW_QUERY_SECONDS=0.5

# Recommended managed-database settings to enforce in the provider console:
# - Automated backups enabled with PITR and at least 7 days retention.
# - Slow query log enabled and shipped to the provider log service.
# - TLS required for remote clients.
# - Separate least-privilege app and migration users.
